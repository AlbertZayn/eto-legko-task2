# Скопируйте в корень репозитория:  cp .env.example .env
# API-ключ: https://tlgk.host/admin → Профиль → API ключи → Создать

KEITARO_BASE_URL=https://tlgk.host/admin_api/v1
KEITARO_API_KEY=ваш_ключ_сюда

# Значения FORTESTS для общего тестового аккаунта
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_SOURCE_ID=836

# SQLite-файл создаётся в backend/, если uvicorn запускать из backend/
DATABASE_URL=sqlite:///./adrobot.db
CAMPAIGN_NAME_PREFIX=test_zaynullin_
